  "binary": "boxhead2play.swf",
  "sha256": "34ff145d96891ddea20278700c8b1fb6fd6273ca0e71b73d8bdf0df183fdbece",
  "data": "DefineSprite_755 frame 1 DoAction: _global.mXSI_Data.mItems (XSI exporter output)",
  "code": [
   "CDrawPrimitive_XSI_DI.FillXSIInfo",
   "CDrawPrimitive_XSI_Animation.Update_CurrentFrame",
   "CThing_Angle.Create_LookupTables",
   "CThing_Creature_Player.GetWeaponPosition",
   "CThing_Creature_Devil.State_Attack"
  ]
 },
 "conventions": {
  "units": "cells (32 px); x east, y south, z height; offsets from the creature position",
  "formula": "n = (vX\u00b7s, sin45\u00b0\u00b7(\u22121)\u00b7vY\u00b7s, \u2212vZ\u00b7s) / 32 where v = XSIInfo.vPosition and s = style sheet mScale",
  "pFactor": -0.707107,
  "tiltDegrees": 45,
  "direction": "index = round(angle256 / (256 / directions)) mod directions; angle256 = floor(radians \u00b7 256 / 2\u03c0) & 255; index 0 faces east, indices increase clockwise on screen",
  "frames": "frames[direction][frameIndex]; walk animations play frameSequence over those frame indices; null means the original falls back to the creature position (isNaN check in GetWeaponPosition)",
  "animation": "player animation = weapon mNameID + \"walk\" when the move changed position this tick, else + \"stand\"; stand animations have 16 directions and one frame"
 },
